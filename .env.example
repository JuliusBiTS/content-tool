# Optional. The app ships with the project's public Supabase URL + anon key
# baked in (see src/lib/supabase.ts) — anon keys are safe in the client, RLS
# protects every table. Only set these to point a fork at a different project.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The TMDB token is never here — it lives only as a Supabase Edge Function secret:
#   supabase secrets set TMDB_TOKEN=your_tmdb_v4_read_access_token
