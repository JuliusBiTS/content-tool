# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The TMDB token is NOT set here — it lives only as a Supabase Edge Function secret:
#   supabase secrets set TMDB_TOKEN=your_tmdb_v4_read_access_token
